<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BootstrapFile Condition="'$(BootstrapFile)' == ''">..\bootstrap.json</BootstrapFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\profiles\hardware-profiles.json" LogicalName="BonsaiSetup.hardware-profiles.json" />
    <EmbeddedResource Include="$(BootstrapFile)" LogicalName="BonsaiSetup.bootstrap.json" />
    <EmbeddedResource Include="..\staging\BonsaiLauncherPayload.zip" LogicalName="BonsaiSetup.launcher-payload.zip" Condition="Exists('..\staging\BonsaiLauncherPayload.zip')" />
  </ItemGroup>
</Project>
